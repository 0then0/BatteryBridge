{
  "name": "batterybridge-gui",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check": "biome check ../.. && node --experimental-strip-types --test tests/*.test.mjs",
    "check:fix": "biome check --write ../..",
    "build:native": "npm run build && cargo build -p batterybridge-gui --features desktop,custom-protocol --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "description": "Desktop tray application for BatteryBridge battery status and charging settings.",
  "license": "Apache-2.0"
}
