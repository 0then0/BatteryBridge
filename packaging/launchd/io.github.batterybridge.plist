<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>io.github.batterybridge</string>
  <key>ProgramArguments</key><array><string>/usr/local/libexec/batterybridge-launcher</string></array>
  <key>UserName</key><string>root</string>
  <key>GroupName</key><string>admin</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardErrorPath</key><string>/var/log/batterybridge.log</string>
</dict></plist>
