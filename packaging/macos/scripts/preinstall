#!/bin/sh
set -eu

if [ "${3:-/}" != / ]; then
    echo 'Install BatteryBridge on the currently running system volume.' >&2
    exit 1
fi

# Never let a privileged payload follow a pre-existing user-controlled link.
for path in \
    /Library/PrivilegedHelperTools \
    /Library/PrivilegedHelperTools/io.github.batterybridge.service \
    /Library/PrivilegedHelperTools/io.github.batterybridge.cli \
    /Library/PrivilegedHelperTools/io.github.batterybridge.launcher \
    /Library/LaunchDaemons \
    /Library/LaunchDaemons/io.github.batterybridge.plist \
    '/Library/Application Support/BatteryBridge' \
    /var/run/batterybridge \
    /Applications/BatteryBridge.app; do
    if [ -L "$path" ]; then
        echo "Refusing symbolic link at $path" >&2
        exit 1
    fi
done

for path in /Library/PrivilegedHelperTools /Library/LaunchDaemons \
    '/Library/Application Support/BatteryBridge' /var/run/batterybridge; do
    if [ -e "$path" ]; then
        owner=$(/usr/bin/stat -f '%u' "$path")
        mode=$(/usr/bin/stat -f '%Lp' "$path")
        if [ ! -d "$path" ] || [ "$owner" != 0 ] || [ "$((0$mode & 022))" -ne 0 ]; then
            echo "Expected a root-owned directory without group/other write access: $path" >&2
            exit 1
        fi
    fi
done

# Stop before replacement, allowing the service to release temporary SMC gates.
if /bin/launchctl print system/io.github.batterybridge >/dev/null 2>&1; then
    /bin/launchctl bootout system/io.github.batterybridge
fi
# A running GUI otherwise keeps its previous embedded frontend after an update.
/usr/bin/pkill -TERM -x batterybridge-gui || [ "$?" -eq 1 ]
